# ==============================================================================
# Bu dosya Git'e GIRER: sadece anahtar ISIMLERI, deger YOK.
# Yeni biri projeyi klonladiginda hangi dosyalari olusturacagini buradan gorur.
# ==============================================================================

# ---- .env.backend-secrets  -> Secret: erasmus-backend-secrets ----
DATABASE_URL=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_PASSWORD=

# ---- .env.backend-config   -> ConfigMap: erasmus-backend-config ----
NODE_ENV=
LOG_LEVEL=
API_PREFIX=
DB_POOL_SIZE=
ENABLE_FILE_LOGGING=
ENABLE_MATCH_QUEUE=
REQUIRE_EMAIL_VERIFICATION=
STORAGE_TYPE=
SMTP_FROM=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
BACKEND_URL=
FRONTEND_URL=
CORS_ORIGIN=
GOOGLE_CLIENT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

# ---- .env.frontend-build   -> docker build --build-arg (K8s'e gitmez) ----
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
