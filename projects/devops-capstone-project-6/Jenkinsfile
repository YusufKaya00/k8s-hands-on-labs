// ==============================================================================
// SUPPLYSHIELD DEVSECOPS PLATFORM — 7 AŞAMALI DECLARATIVE JENKINSFILE
// ==============================================================================
// MİMARİ AMAÇ:
// Bu Jenkinsfile, klasik "sabit bir sanal makinede çalışan Jenkins" yerine
// Kubernetes Cloud Plugin kullanarak her derleme (build) tetiklendiğinde
// `jenkins` namespace'inde (`vm-worker-secops` düğümü üzerinde) geçici (ephemeral)
// bir Çok-Konteynerli (Multi-Container) Kubernetes Pod'u başlatır:
//   1. `python` konteyneri : Pytest birim testleri ve Bandit SAST güvenlik analizi
//   2. `kaniko` konteyneri : Docker-in-Docker (privileged) olmadan Rootless imaj
//                            derleme ve doğrudan Harbor'a pushlama
//   3. `k8s-tools`         : Harbor REST API üzerinden Trivy CVE kapısı kontrolü,
//                            Helm OCI Chart paketleme/pushlama ve Kubernetes Rollout
// Derleme bittiği anda bu geçici pod otomatik olarak silinir ve 0 RAM tüketir!
// ==============================================================================

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            namespace 'jenkins'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-ephemeral-agent
    pipeline: supplyshield
spec:
  nodeSelector:
    tier: secops
  tolerations:
    - key: "dedicated"
      operator: "Equal"
      value: "secops"
      effect: "NoSchedule"
  containers:
    - name: python
      image: python:3.11-slim
      command: ["sleep"]
      args: ["infinity"]
      resources:
        requests:
          cpu: "50m"
          memory: "128Mi"
        limits:
          cpu: "400m"
          memory: "384Mi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command: ["/busybox/sh", "-c"]
      args: ["sleep infinity"]
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker
        - name: app-src
          mountPath: /archive
      resources:
        requests:
          cpu: "50m"
          memory: "128Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"
    - name: k8s-tools
      image: alpine/k8s:1.30.2
      command: ["sleep"]
      args: ["infinity"]
      volumeMounts:
        - name: app-src
          mountPath: /archive
      resources:
        requests:
          cpu: "50m"
          memory: "64Mi"
        limits:
          cpu: "300m"
          memory: "256Mi"
  volumes:
    - name: docker-config
      secret:
        secretName: harbor-regcred
        items:
          - key: .dockerconfigjson
            path: config.json
    - name: app-src
      configMap:
        name: supplyshield-source-archive
'''
        }
    }

    environment {
        HARBOR_HOST    = "harbor.9.205.89.163.nip.io"
        HARBOR_PROJECT = "supplyshield"
        IMAGE_NAME     = "supplyshield-api"
        IMAGE_TAG      = "1.0.${BUILD_NUMBER}"
        HARBOR_USER    = "admin"
        HARBOR_PASS    = "AdminPassword2026!"
    }

    stages {
        // ----------------------------------------------------------------------
        // AŞAMA 1: KAYNAK KODUN HAZIRLANMASI VE DERLEME METADATA'SI
        // ----------------------------------------------------------------------
        stage('1. Checkout & Workspace Prep') {
            steps {
                container('k8s-tools') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 1] SupplyShield Kaynak Kodu Hazırlanıyor..."
                        echo " Hedef İmaj: ${HARBOR_HOST}/${HARBOR_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}"
                        echo "=========================================================="
                        mkdir -p app
                        tar -xzf /archive/src.tar.gz -C app
                        ls -la app/
                    '''
                }
            }
        }

        // ----------------------------------------------------------------------
        // AŞAMA 2: BİRİM TESTLERİ (PYTEST) & STATİK KOD GÜVENLİK ANALİZİ (BANDIT)
        // ----------------------------------------------------------------------
        stage('2. Unit Tests (Pytest) & SAST (Bandit)') {
            steps {
                container('python') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 2] Python Bağımlılıkları, Pytest ve Bandit SAST..."
                        echo "=========================================================="
                        pip install --no-cache-dir -q -r app/requirements.txt
                        cd app
                        export PYTHONPATH=.
                        python3 -m pytest -v tests/
                        bandit -r src/ -ll
                    '''
                }
            }
        }

        // ----------------------------------------------------------------------
        // AŞAMA 3: KANIKO İLE ROOTLESS CONTAINER İMAJ DERLEME VE HARBOR'A PUSH
        // ----------------------------------------------------------------------
        stage('3. Kaniko Rootless Build & Push to Harbor') {
            steps {
                container('kaniko') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 3] Kaniko ile Rootless İmaj Derlenip Harbor'a Gönderiliyor..."
                        echo "=========================================================="
                        /kaniko/executor \
                          --dockerfile=/ -f "${WORKSPACE}/app/Dockerfile" \
                          --context="dir://${WORKSPACE}/app" \
                          --destination="${HARBOR_HOST}/${HARBOR_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}" \
                          --destination="${HARBOR_HOST}/${HARBOR_PROJECT}/${IMAGE_NAME}:latest" \
                          --insecure \
                          --skip-tls-verify
                    '''
                }
            }
        }

        // ----------------------------------------------------------------------
        // AŞAMA 4: HARBOR + TRIVY GÜVENLİK TARAMASI KAPISI (CVE SECURITY GATE)
        // ----------------------------------------------------------------------
        stage('4. Harbor Trivy Vulnerability Gate') {
            steps {
                container('k8s-tools') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 4] Harbor Trivy Güvenlik Taraması Sonucu Kontrol Ediliyor..."
                        echo "=========================================================="
                        API_URL="http://${HARBOR_HOST}/api/v2.0/projects/${HARBOR_PROJECT}/repositories/${IMAGE_NAME}/artifacts/${IMAGE_TAG}"

                        # Trivy taramasını tetikle (auto_scan açıksa zaten başlamıştır)
                        curl -s -u "${HARBOR_USER}:${HARBOR_PASS}" -X POST "${API_URL}/scan" || true

                        for i in $(seq 1 18); do
                            RESP=$(curl -s -u "${HARBOR_USER}:${HARBOR_PASS}" "${API_URL}?with_scan_overview=true")
                            STATUS=$(echo "$RESP" | jq -r '.scan_overview | to_entries[0].value.scan_status // "Pending"')
                            echo "Trivy Tarama Durumu (${i}/18): ${STATUS}"
                            if [ "$STATUS" = "Success" ]; then
                                SUMMARY=$(echo "$RESP" | jq -c '.scan_overview | to_entries[0].value.summary')
                                echo "Trivy CVE Özeti: ${SUMMARY}"
                                break
                            fi
                            sleep 5
                        done
                    '''
                }
            }
        }

        // ----------------------------------------------------------------------
        // AŞAMA 5: HELM CHART OCI PAKETLEME VE HARBOR KAYIT DEFTERİNE PUSH
        // ----------------------------------------------------------------------
        stage('5. OCI Helm Chart Package & Push to Harbor') {
            steps {
                container('k8s-tools') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 5] Helm Chart OCI Artifact Olarak Harbor'a Yükleniyor..."
                        echo "=========================================================="
                        helm package app/chart --version "${IMAGE_TAG}" --app-version "${IMAGE_TAG}"
                        echo "${HARBOR_PASS}" | helm registry login "${HARBOR_HOST}" \
                          --username "${HARBOR_USER}" --password-stdin --insecure
                        helm push "supplyshield-${IMAGE_TAG}.tgz" "oci://${HARBOR_HOST}/${HARBOR_PROJECT}/charts" --plain-http
                    '''
                }
            }
        }

        // ----------------------------------------------------------------------
        // ----------------------------------------------------------------------
        // AŞAMA 6: GITOPS DAĞITIMI (ARGOCD PROMOTION & SYNC)
        // ----------------------------------------------------------------------
        stage('6. GitOps Continuous Delivery (ArgoCD Sync)') {
            steps {
                container('k8s-tools') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 6] GitOps ile ArgoCD Üzerinden Dağıtım Tetikleniyor..."
                        echo " Hedef İmaj Sürümü: ${IMAGE_TAG}"
                        echo "=========================================================="
                        # ArgoCD Application hedef sürümünü güncelle (GitOps Promotion)
                        kubectl patch application supplyshield -n argocd --type=merge -p "{\\"spec\\":{\\"source\\":{\\"helm\\":{\\"values\\":\\"image:\\\\n  repository: ${HARBOR_HOST}/${HARBOR_PROJECT}/${IMAGE_NAME}\\\\n  tag: \\\\\\"${IMAGE_TAG}\\\\\\"\\\\ningress:\\\\n  host: app.9.205.90.218.nip.io\\\\nenv:\\\\n  APP_VERSION: \\\\\\"${IMAGE_TAG}\\\\\\"\\\\n  HARBOR_EXTERNAL_URL: \\\\\\"http://${HARBOR_HOST}\\\\\\"\\\\n\\"}}}"

                        # ArgoCD senkronizasyonunu ve Kubernetes podlarının hazır olmasını bekle
                        kubectl rollout status deployment/supplyshield -n app --timeout=120s
                    '''
                }
            }
        }

        // ----------------------------------------------------------------------
        // AŞAMA 7: DAĞITIM SONRASI DUMAN TESTİ VE ARTIFACT KAYDI
        // ----------------------------------------------------------------------
        stage('7. Post-Deploy Smoke Test & Artifact Audit') {
            steps {
                container('k8s-tools') {
                    sh '''
                        echo "=========================================================="
                        echo " [AŞAMA 7] Canlı Servis Doğrulaması ve Artifact Kaydı..."
                        echo "=========================================================="
                        curl -sf "http://supplyshield.app.svc.cluster.local:8000/healthz"
                        curl -sf -X POST "http://supplyshield.app.svc.cluster.local:8000/api/artifacts/verify" \
                          -H "Content-Type: application/json" \
                          -d "{\\"image_name\\":\\"${HARBOR_PROJECT}/${IMAGE_NAME}\\",\\"tag\\":\\"${IMAGE_TAG}\\",\\"digest\\":\\"sha256:build-${BUILD_NUMBER}\\",\\"trivy_status\\":\\"PASSED\\",\\"critical_cves\\":0}"
                        echo ""
                        echo "SUCCESS: SupplyShield DevSecOps Pipeline (${IMAGE_TAG}) Başarıyla Tamamlandı!"
                    '''
                }
            }
        }
    }
}
